# ============================================================
# 八叉树项目 - 本地路径配置模板
# ============================================================
# 使用说明：
#   1. 复制此文件，重命名为 .env（去掉 .example 后缀）
#   2. 修改下方路径为你本机的实际路径
#   3. .env 文件已被 .gitignore 忽略，不会提交到代码仓库
#   4. 若数据目录在项目根目录的 data/ 文件夹内，可不创建 .env，
#      config.py 会自动使用相对路径，无需任何配置
# ============================================================

# FS-Jump3D 原始数据目录（NPY 格式）
# 默认值：<项目根>/data/npy
# FS_JUMP3D_DATA_DIR=D:/datasets/FS-Jump3D/data/npy

# 训练集目录（由 split_dataset.py 生成）
# 默认值：<项目根>/data/npy_train
# TRAIN_DATA_DIR=D:/datasets/FS-Jump3D/data/npy_train

# 测试集目录（由 split_dataset.py 生成）
# 默认值：<项目根>/data/npy_test
# TEST_DATA_DIR=D:/datasets/FS-Jump3D/data/npy_test

# 视频姿态流水线使用的外部仓库（相对路径以本项目根目录为基准）
# 默认值：本项目同级目录下的 mmpose-main 和 MotionAGFormer-master
# MMPOSE_ROOT=../mmpose-main
# MOTIONAGFORMER_ROOT=../MotionAGFormer-master

# 本机当前处理的视频；也可以在运行时通过 --name 和 --video-dir 覆盖
# PIPELINE_VIDEO_NAME=test
# PIPELINE_VIDEO_DIR=input_videos/finefs_test
